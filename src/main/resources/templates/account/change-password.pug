extends ../layout

block content
  .account(data-test="change-password-page")
    .account__header
      h2.account__title(data-test="change-password-title") Change Password

    .account__layout
      - var navItems = changePasswordPage.navItems()
      include _nav.pug

      .account__content
        if changePasswordPage.successMessage()
          .alert.alert--success(data-test="change-password-success-message")= changePasswordPage.successMessage()

        if changePasswordPage.errorMessage()
          .alert.alert--error(data-test="change-password-error-message")= changePasswordPage.errorMessage()

        .card
          .card__body
            form.form(method="POST" action="/account/change-password" data-test="change-password-form")
              if _csrf
                input(type="hidden" name=_csrf.parameterName value=_csrf.token)
              .form__group
                label.form__label(for="currentPassword") Current Password
                input.form__input#currentPassword(type="password" name="currentPassword" required autofocus placeholder="Your current password" data-test="change-password-current-password-input")

              .form__group
                label.form__label(for="newPassword") New Password
                input.form__input#newPassword(type="password" name="newPassword" required minlength="8" maxlength="72" placeholder="Your new password" data-test="change-password-new-password-input")
                p.form__hint Password must be at least 8 characters and contain an uppercase letter, a lowercase letter and a digit

              .form__group
                label.form__label(for="confirmPassword") Confirm New Password
                input.form__input#confirmPassword(type="password" name="confirmPassword" required maxlength="72" placeholder="Repeat your new password" data-test="change-password-confirm-password-input")

              .form__actions
                button.btn.btn--primary(type="submit" data-test="change-password-submit-button") Change Password
